                groupcollapsible {
                    name    "folder1_#_#"
                    label   "Sidesets (Boundary Conditions)"
                    disablewhentab "{ is_obstacle# != 0 }"
                    disablewhen "{ is_obstacle# != 0 }"
                    hidewhentab "{ is_obstacle# != 0 }"
                    hidewhen "{ is_obstacle# != 0 }"

                    multiparm {
                        name    "sideset_selection#_#"
                        label    "Number of Sidesets"
                        disablewhen "{ is_obstacle# != 0 }"
                        hidewhen "{ is_obstacle# != 0 }"
                        parmtag { "script_callback" "hou.pwd().hm().create_group(kwargs)" }
                        parmtag { "script_callback_language" "python" }

                        parm {
                            name    "grouptype#_#_#"
                            label   "Select"
                            type    ordinal
                            default { "0" }
                            menu {
                                "primitive" "Faces"
                                "point"     "Points (mesh nodes)"
                            }
                            help    "Whether the Base Group selects boundary faces (Primitives) or mesh nodes (Points). Faces are the normal choice. A Points sideset is exported as a node selection and can carry Dirichlet conditions only: PolyFEM applies tractions and pressures to faces, so a load on points is refused instead of silently doing nothing."
                            parmtag { "autoscope" "0000000000000000" }
                            parmtag { "autoselect" "0000000000000000" }
                            parmtag { "script_callback_language" "python" }
                        }
                        parm {
                            name    "basegroup#_#_#"
                            label   "Selection"
                            type    string
                            default { "" }
                            help    "The boundary faces this sideset covers. Pick them in the viewport, type * for the whole surface of this subdomain, or type a selection that is evaluated on face centres (after the transform): axis:+z:0.99 (centre z >= 0.99; -z means <=), box:[x0,y0,z0],[x1,y1,z1], sphere:[cx,cy,cz],r or plane:[nx,ny,nz],[px,py,pz] (the side the normal points to). A selection that catches no face is an error. A face in several sidesets receives the conditions of all of them; the Export Report on the Main tab lists such faces."
                            parmtag { "script_action" "import soputils\nparent = kwargs['node']\nparent.allowEditingOfContents(True)\nbutton_number = kwargs['script_multiparm_index3']\nvolumn_number = kwargs['script_multiparm_index2']\nsurf_number = kwargs['script_multiparm_index']\ngroup_node = parent.node(\"group_\"+str(button_number)+\"_\"+str(volumn_number)+\"_\"+str(surf_number))\nif group_node:\n    kwargs['node'] = group_node\n    kwargs['geometrytype'] = kwargs['node'].parmTuple('grouptype')\n    kwargs['inputindex'] = 0\n    kwargs['ordered'] = kwargs['node'].parm('ordered').eval()\n    soputils.selectGroupParm(kwargs)\n\n\n" }
                            parmtag { "script_action_help" "Select geometry from an available viewport.\nShift-click to turn on Select Groups." }
                            parmtag { "script_action_icon" "BUTTONS_reselect" }
                            parmtag { "script_callback" "" }
                        }
                        parm {
                            name    "geo_label3_#_#_#"
                            label   ""
                            type    label
                            default { "Pick faces in the viewport, type * for every face of this subdomain, or type a selection such as axis:-z:0.01." }
                            parmtag { "sidefx::look" "block" }
                        }
                        parm {
                            name    "geo_sep5_#_#_#"
                            label   "Spacer"
                            type    separator
                            default { "" }
                            parmtag { "export_disable" "1" }
                            parmtag { "sidefx::layout_height" "large" }
                            parmtag { "sidefx::look" "blank" }
                        }
                        multiparm {
                            name    "Boundary_Condition__#_#_#"
                            label    "Num of Boundary Conditions"
                            disablewhen "{ is_obstacle# != 0 }"
                            hidewhen "{ is_obstacle# != 0 }"

                            parm {
                                name    "boundary_type#_#_#_#"
                                label   "Boundary Type"
                                type    ordinal
                                default { "0" }
                                menu {
                                    "Dirichlet"                 "Dirichlet"
                                    "Neumann"                   "Neumann"
                                    "Normal_Aligned_Neumann"    "Normal Aligned Neumann"
                                    "Pressure_Boundary"         "Pressure Boundary"
                                    "Pressure_Cavity"           "Pressure Cavity"
                                    "Nodal_Neumann"             "Nodal Force (Nodal Neumann)"
                                }
                                help    "What is imposed on this sideset. Dirichlet = prescribed displacement (fixes or moves the surface or points). Neumann = applied traction (force per area) with a fixed direction. Normal Aligned Neumann = traction along the surface normal (positive pushes inward). Pressure Boundary = pressure following the deforming surface. Pressure Cavity = pressure inside a closed cavity. Nodal Force (Nodal Neumann) = concentrated force vector applied directly to selected mesh nodes (requires Group Type = Points). All conditions of a sideset act on all of its members: Dirichlet components are combined (a component set twice must have the same value), loads of one kind are added, and a Neumann and a Normal Aligned Neumann cannot share faces (PolyFEM would keep only the second)."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "bc_vec#_#_#_#"
                                label   "Value [x, y, z]"
                                type    string
                                size    3
                                default { "0" "0" "0" }
                                disablewhen "{ boundary_type#_#_#_# != Neumann boundary_type#_#_#_# != Dirichlet boundary_type#_#_#_# != Nodal_Neumann }"
                                hidewhen "{ boundary_type#_#_#_# != Neumann boundary_type#_#_#_# != Dirichlet boundary_type#_#_#_# != Nodal_Neumann }"
                                help    "Displacement (Dirichlet, length units), traction (Neumann, force per area), or concentrated nodal force (Nodal Force, force units) for X, Y, Z. Enter a plain number (0, -0.01) or any PolyFEM TinyExpr formula of x, y, z, t without quotes (quotes are also accepted): e.g. -0.01*t, 1000*smoothstep(t)*sin(pi*x), if(t-0.5, -0.02, -0.04*t). Functions: sin, cos, tan, exp, ln, log, log10, pow, sqrt, abs, ceil, floor, pi, e, min, max, smoothstep, half_smoothstep, deg2rad, rotate_2D_x, rotate_2D_y, if, compare, smooth_abs, sign. Use ^ for powers (not **)."
                                parmtag { "script_callback" "hou.pwd().hm().sync_expr_vector(kwargs)" }
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "vector_#_#_#_#"
                                label   "Value [x, y, z] (legacy)"
                                type    string
                                invisible
                                default { "[\"0*t\",\"0*t\",\"0*t\"]" }
                                disablewhen "{ boundary_type#_#_#_# != Neumann boundary_type#_#_#_# != Dirichlet boundary_type#_#_#_# != Nodal_Neumann }"
                                hidewhen "{ boundary_type#_#_#_# != Neumann boundary_type#_#_#_# != Dirichlet boundary_type#_#_#_# != Nodal_Neumann }"
                                help    "Legacy JSON-list storage kept hidden for compatibility with older scenes."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "value_#_#_#_#"
                                label   "Value"
                                type    string
                                default { "0" }
                                disablewhen "{ boundary_type#_#_#_# != Normal_Aligned_Neumann boundary_type#_#_#_# != Pressure_Boundary boundary_type#_#_#_# != Pressure_Cavity }"
                                hidewhen "{ boundary_type#_#_#_# != Normal_Aligned_Neumann boundary_type#_#_#_# != Pressure_Boundary boundary_type#_#_#_# != Pressure_Cavity }"
                                help    "Scalar magnitude (force per area) of the normal traction or pressure. Enter a plain number (1000) or a PolyFEM TinyExpr formula of x, y, z, t without quotes (quotes are also accepted): e.g. 1000*t, 500*smoothstep(t), if(t-1, 1000, 1000*t)."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "x_dimension#_#_#_#"
                                label   "x"
                                type    toggle
                                joinnext
                                default { "1" }
                                hidewhen "{ boundary_type#_#_#_# == Neumann } { boundary_type#_#_#_# == Normal_Aligned_Neumann } { boundary_type#_#_#_# == Pressure_Boundary } { boundary_type#_#_#_# == Pressure_Cavity } { boundary_type#_#_#_# == Nodal_Neumann }"
                                help    "Apply the Dirichlet condition to the x component. Turn off to leave x free (e.g. a roller support that only constrains z)."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "y_dimension#_#_#_#"
                                label   "y"
                                type    toggle
                                joinnext
                                default { "1" }
                                hidewhen "{ boundary_type#_#_#_# == Neumann } { boundary_type#_#_#_# == Normal_Aligned_Neumann } { boundary_type#_#_#_# == Pressure_Boundary } { boundary_type#_#_#_# == Pressure_Cavity } { boundary_type#_#_#_# == Nodal_Neumann }"
                                help    "Apply the Dirichlet condition to the y component. Turn off to leave y free."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "z_dimension#_#_#_#"
                                label   "z"
                                type    toggle
                                default { "1" }
                                hidewhen "{ boundary_type#_#_#_# == Neumann } { boundary_type#_#_#_# == Normal_Aligned_Neumann } { boundary_type#_#_#_# == Pressure_Boundary } { boundary_type#_#_#_# == Pressure_Cavity } { boundary_type#_#_#_# == Nodal_Neumann }"
                                help    "Apply the Dirichlet condition to the z component. Turn off to leave z free."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "time_curve#_#_#_#"
                                label   "Time Curve"
                                type    ordinal
                                default { "0" }
                                menu {
                                    "entered"   "Value as entered"
                                    "ramp"      "Ramp from 0 to the value"
                                    "animated"  "Animated multiplier (keyframes)"
                                }
                                help    "How this condition changes over time. Value as entered: exactly the value above (it may itself be an expression of time t). Ramp from 0 to the value: the value is multiplied by a ramp from 0 to 1 over the whole run (or between Ramp Start and Ramp End with Custom Ramp Times) that then stays at 1. Animated multiplier: the value is multiplied by the Multiplier below, which you keyframe on Houdini's timeline like any other parameter (Alt+click its field, or right-click > Keyframes); the Time tab's Start Frame and Time Scale say which Houdini frame is which simulation time. The multiplier is read at every time step of the run (PolyFEM evaluates conditions only there) and exported as a time table (PolyFEM's interpolation), so changing dt never moves the curve in time."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "ramp_custom#_#_#_#"
                                label   "Custom Ramp Times"
                                type    toggle
                                default { "0" }
                                hidewhen "{ time_curve#_#_#_# != ramp }"
                                help    "Off: the ramp spans the whole run, from 0 at Start Time to the full value at the last time step. On: it starts at Ramp Start and reaches the full value at Ramp End."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "ramp_start#_#_#_#"
                                label   "Ramp Start"
                                type    float
                                joinnext
                                default { "0" }
                                hidewhen "{ time_curve#_#_#_# != ramp } { ramp_custom#_#_#_# == 0 }"
                                range   { 0 10 }
                                help    "Simulation time at which the ramp starts; the multiplier is 0 until then."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "ramp_end#_#_#_#"
                                label   "Ramp End"
                                type    float
                                default { "1" }
                                hidewhen "{ time_curve#_#_#_# != ramp } { ramp_custom#_#_#_# == 0 }"
                                range   { 0 10 }
                                help    "Simulation time at which the ramp reaches 1 (the full value), which it keeps afterwards. Must be later than Ramp Start."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "curve_multiplier#_#_#_#"
                                label   "Multiplier [x, y, z]"
                                type    vector
                                size    3
                                default { "1" "1" "1" }
                                hidewhen "{ time_curve#_#_#_# != animated } { boundary_type#_#_#_# == Normal_Aligned_Neumann } { boundary_type#_#_#_# == Pressure_Boundary } { boundary_type#_#_#_# == Pressure_Cavity }"
                                range   { -1 1 }
                                help    "Keyframe these on the timeline: each component multiplies the same component of Value at every time step. For example, Value [0, 0, -0.005] with z keyed 0 at the start frame, 1 halfway and 0 at the end pushes the surface 5 mm down and back. Bezier, ease and linear keys, expressions and CHOP exports all work: the channel itself is evaluated at each step."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "curve_scale#_#_#_#"
                                label   "Multiplier"
                                type    float
                                default { "1" }
                                hidewhen "{ time_curve#_#_#_# != animated } { boundary_type#_#_#_# == Dirichlet } { boundary_type#_#_#_# == Neumann } { boundary_type#_#_#_# == Nodal_Neumann }"
                                range   { -1 1 }
                                help    "Keyframe this on the timeline: it multiplies Value at every time step (a load or pressure curve). Bezier, ease and linear keys, expressions and CHOP exports all work: the channel itself is evaluated at each step. A curve on Pressure Boundary or Pressure Cavity needs PolyFEM ddb4579a3 or later."
                                parmtag { "script_callback_language" "python" }
                            }
                            parm {
                                name    "curve_hint#_#_#_#"
                                label   ""
                                type    label
                                default { "Keyframe the Multiplier on the timeline (Alt+click its field). The Time tab's Start Frame and Time Scale relate frames to simulation time." }
                                hidewhen "{ time_curve#_#_#_# != animated }"
                                parmtag { "sidefx::look" "block" }
                            }
                        }

                    }

                }
