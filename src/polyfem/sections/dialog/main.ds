    group {
        name    "Main"
        label   "Main"

        parm {
            name    "polyfem_bin"
            label   "PolyFEM Binary"
            type    file
            default { "" }
            help    "Path to the PolyFEM executable (PolyFEM_bin) that will run the simulation. Point it at the binary you built; the Run buttons call it with the params.json this node writes."
            parmtag { "script_callback" "hou.pwd().hm().polyfem_bin_check(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "working_dir"
            label   "Working Directory"
            type    directory
            default { "" }
            help    "Folder where this node writes everything: input/ (params.json, copied meshes, selection and fiber files) and output/ (results, log). Use one folder per simulation setup. If output/ already holds the results of an earlier run (for example a run you imported), Write and Run ask first: overwrite them, or continue in a new folder (<folder>_run2, ...)."
            parmtag { "script_callback" "hou.pwd().hm().working_dir_check(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "resume_checkpoint"
            label   "Resume Checkpoint"
            type    file
            default { "" }
            help    "Optional self-contained checkpoint file. When set, the checkpoint's saved geometry, materials, time and solver settings govern continuation; current physics controls are ignored. Working Directory chooses the new output location; binary, maximum threads and log level still come from this node. Clear this field to run the current scene. The solver validates compatibility; old state.txt and restart.json are not checkpoints."
            parmtag { "filechooser_mode" "read" }
        }
        parm {
            name    "resume_reorder"
            label   "Reorder Checkpoint Mesh"
            type    toggle
            default { "0" }
            disablewhen "{ resume_checkpoint == \"\" }"
            help    "Reorder the checkpoint mesh before solving. This is restored from input.checkpoint.reorder when importing a checkpoint configuration."
        }
        parm {
            name    "main_sep"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "check_setup"
            label   "Check Setup"
            type    button
            joinnext
            default { "0" }
            help    "List every problem in the setup at once, before PolyFEM runs: errors PolyFEM could not run (a missing binary, a 2D mesh, a mirrored transform, an unfinished material, conflicting sideset conditions, unsupported hexahedral orders) and warnings for setups that are legal but usually wrong (a body nothing holds in a quasistatic run, a contact distance that is large for the model). Write and both Run buttons run the same check first: errors stop them; warnings are confirmed once before a run and only reported by Write. The result is in Check Setup Report below."
            parmtag { "script_callback" "hou.phm().check_setup_button(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "write_only"
            label   "Write params.json Only"
            type    button
            default { "0" }
            help    "Write params.json and the input files without running anything. Useful to inspect or hand-edit the setup, or to run PolyFEM yourself from a shell or on another machine. Check Setup runs first; its errors stop the write, its warnings are only reported."
            parmtag { "script_callback" "hou.pwd().hm().write_params_only(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "Export_params"
            label   "Run in Terminal"
            type    button
            joinnext
            default { "0" }
            help    "Check the setup, write params.json and all input files, then run PolyFEM in a terminal window so you can watch its output. Run Status below follows the run (step, time, and at the end what the exit status means); Stop ends it. The window's text is also saved to output/terminal_log.txt."
            parmtag { "script_callback" "hou.pwd().hm().write_params(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "run_background"
            label   "Run in Background"
            type    button
            default { "0" }
            help    "Check the setup, write the inputs and run PolyFEM without a terminal window. Houdini stays responsive; Run Status below follows the run, and its output goes to <working_dir>/output/log.txt (Open Log / Show Log). A second run into a folder whose run is still going is refused."
            parmtag { "script_callback" "hou.pwd().hm().run_background(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "run_status"
            label   "Run Status"
            type    string
            default { "No run yet." }
            disablewhen "{ working_dir != __polyfem_report_edit_sentinel__ }"
            help    "What the last run started from this node is doing: running (time step k of N and the simulated time), completed, or stopped -- with the meaning of PolyFEM's exit status: 0 completed; 1 a named failure, not a crash (the reason from the log's 'PolyFEM stopped:' line is shown); 3 a resource limit, a safety stop that keeps the written steps; a signal means the solver crashed or was killed. Updated about once a second. Read-only."
            parmtag { "editor" "1" }
            parmtag { "editorlines" "1-4" }
        }
        parm {
            name    "stop_run"
            label   "Stop"
            type    button
            joinnext
            default { "0" }
            help    "Stop the PolyFEM run writing into this Working Directory (asks first). The time steps already written stay on disk and can be opened."
            parmtag { "script_callback" "hou.phm().stop_run(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "open_log"
            label   "Open Log"
            type    button
            joinnext
            default { "0" }
            help    "Open the latest run's log in your text editor (output/log.txt for Run in Background, output/terminal_log.txt for Run in Terminal)."
            parmtag { "script_callback" "hou.phm().open_log(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "show_log"
            label   "Show Log"
            type    button
            joinnext
            default { "0" }
            help    "Show the last 60 lines of the latest run's log in a dialog."
            parmtag { "script_callback" "hou.pwd().hm().show_log(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "open_results"
            label   "Open Results"
            type    button
            default { "0" }
            help    "Show this run's results: creates a Read PVD node next to this one the first time (and reuses it afterwards), loads output/<PolyFEM file name>.pvd, sets the playbar to its time steps and frames the viewport on it. Works while the run is still going (press again to pick up new steps)."
            parmtag { "script_callback" "hou.phm().open_results(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm5"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "check_report"
            label   "Check Setup Report"
            type    string
            default { "Not checked yet: press Check Setup, or Write/Run." }
            disablewhen "{ working_dir != __polyfem_report_edit_sentinel__ }"
            help    "The last Check Setup result: errors (PolyFEM cannot run this setup), warnings (legal but usually wrong) and notes. Read-only."
            parmtag { "editor" "1" }
            parmtag { "sidefx::look" "block" }
        }
        parm {
            name    "export_report"
            label   "Export Report"
            type    string
            default { "Nothing has been written yet." }
            disablewhen "{ working_dir != __polyfem_report_edit_sentinel__ }"
            help    "What the last Write or Run applied to every sideset: the faces (or nodes) it covers and its conditions, plus the faces that lie in several sidesets (they receive the conditions of all of them). Read-only."
            parmtag { "editor" "1" }
            parmtag { "sidefx::look" "block" }
        }
        parm {
            name    "main_sep2"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "expert_mode"
            label   "Show Expert Controls"
            type    toggle
            joinnext
            default { "0" }
            help    "Show the advanced solver settings: the Augmented Lagrangian, Rayleigh damping, Semi-Implicit contact options, AMGCL and Hypre linear-solver settings, the Strong Wolfe line search, the finite-difference gradient check and Output > Advanced (debug output). Hiding them never changes their values: whatever they are set to is exported either way, and Check Setup lists any that differ from their defaults while they are hidden."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "rebuild_display"
            label   "Rebuild Display Network"
            type    button
            default { "0" }
            help    "Rebuild the internal viewport display SOPs (surface extraction, subdomain colors, disabled dimming, fiber preview, and sideset selection groups) from the current asset definition while keeping every transform, material, subdomain, sideset, and boundary condition intact."
            parmtag { "script_callback" "hou.pwd().hm().rebuild_display_network(kwargs)" }
            parmtag { "script_callback_language" "python" }
        }
        groupcollapsible {
            name    "import_folder"
            label   "Import a Previous Run"

            parm {
                name    "old_input_dir"
                label   "Input Directory"
                type    directory
                default { "" }
                help    "Folder of a previous simulation (its root or its input/ folder) whose params.json you want to load into this node. Older PolyFEM files are converted as far as possible."
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "newparameter2"
                label   "Import"
                type    button
                default { "0" }
                help    "Read the params.json found in Input Directory and set this node's parameters from it. Geometry, transforms, materials, time, contact and solver settings are restored; anything that could not be mapped is listed in the Import Report."
                parmtag { "export_disable" "1" }
                parmtag { "script_callback" "hou.pwd().hm().read_params(kwargs)" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "labelparm4"
                label   ""
                type    label
                default { "Pick a previous simulation folder (or its input folder). Older PolyFEM files are imported as far as possible; the Import Report lists anything that could not be reconstructed." }
                parmtag { "sidefx::look" "block" }
            }
            parm {
                name    "import_report"
                label   "Import Report"
                type    string
                default { "No parameter folder has been imported." }
                disablewhen "{ old_input_dir != __polyfem_report_edit_sentinel__ }"
                help    "Notes from the last import: values that were converted, dropped or could not be reconstructed. Read-only."
                parmtag { "editor" "1" }
                parmtag { "sidefx::look" "block" }
            }
        }
    }
