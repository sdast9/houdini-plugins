            parm {
                name    "friction_iterations"
                label   "Friction Iterations"
                type    integer
                default { "1" }
                disablewhen "{ enable == 0 }"
                range   { 0 10 }
                help    "Number of times per step the friction forces are updated with the new sliding state (lagged friction, as in the IPC paper). 1 is the standard; more iterations tighten the friction/contact coupling at extra cost."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "friction_convergence_tol"
                label   "Friction Converg Tol"
                type    log
                default { "0.01" }
                disablewhen "{ enable == 0 }"
