            parm {
                name    "adhesion_strength"
                label   "strength"
                type    log
                default { "0.001" }
                disablewhen "{ adhesion_enable == 0 }"
                range   { 0 1 }
                help    "Strength of the normal (pull-together) adhesion force, in stress-like units."
