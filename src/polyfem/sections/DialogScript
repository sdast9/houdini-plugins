            }
            parm {
                name    "split_acceptance_tol"
                label   "Acceptance Tolerance"
                type    log
                default { "0.001" }
                disablewhen "{ split_enabled == 0 }"
                range   { 0! 1 }
                help    "A split is kept only if it lowers the energy by at least this amount (relative). Smaller values accept more splits and refine more aggressively."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "split_culling_threshold"
                label   "Culling Threshold"
                type    log
                default { "0.95" }
                disablewhen "{ split_enabled == 0 }"
                range   { 0! 1! }
                help    "Only edges whose energy is in the top fraction (1 - threshold) of the mesh are considered for splitting. 0.95 = only the 5% most strained edges."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "split_max_depth"
                label   "Max Split Depth per TS"
                type    integer
                default { "3" }
                disablewhen "{ split_enabled == 0 }"
                range   { 1! 10 }
                help    "How many times an edge may be split within one time step. Limits runaway refinement."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "min_edge_length"
                label   "Min Edge Length"
                type    log
                default { "1e-06" }
                disablewhen "{ split_enabled == 0 }"
                range   { 0! 1 }
                help    "Edges shorter than this (length units) are never split, which stops refinement from producing tiny elements."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "split_1"
            label   "Collapsing"

            parm {
                name    "collapse_enabled"
                label   "Enable Collapsing"
                type    toggle
                default { "1" }
                help    "Allow edges to be collapsed (mesh coarsening where the deformation is mild)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "collapse_acceptance_tol"
                label   "Acceptance Tolerance"
                type    float
                default { "-1e-08" }
                disablewhen "{ collapse_enabled == 0 }"
                range   { -1 0! }
                help    "A collapse is kept only if the energy does not rise by more than this amount (negative values allow a small increase). Coarsening is a trade of accuracy for speed."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "collapse_culling_threshold"
                label   "Culling Threshold"
                type    log
                default { "0.01" }
                disablewhen "{ collapse_enabled == 0 }"
                range   { 0! 1! }
                help    "Only edges whose energy is in the bottom fraction of the mesh are considered for collapsing. 0.01 = only the 1% least strained edges."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "collapse_max_depth"
                label   "Max Collapse Depth per TS"
                type    integer
                default { "3" }
                disablewhen "{ collapse_enabled == 0 }"
                range   { 1! 10 }
                help    "How many times an edge may be collapsed within one time step."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "rel_max_edge_length"
                label   "Rel Max Edge Length"
                type    log
                default { "1" }
                disablewhen "{ collapse_enabled == 0 }"
                range   { 0! 1 }
                help    "Never create edges longer than this multiple of the mesh's initial shortest edge when collapsing. Keeps coarsening bounded."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "abs_max_edge_length"
                label   "Abs Max Edge Length"
                type    log
                default { "1e+100" }
                disablewhen "{ collapse_enabled == 0 }"
                range   { 0! 1e+09 }
                help    "Never create edges longer than this absolute length when collapsing. Leave very large to disable this limit."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "split_3"
            label   "Swap"

            parm {
                name    "swap_enabled2"
                label   "Enable Edge/Face Swap"
                type    toggle
                default { "0" }
                help    "Allow edge/face swaps (flips) that improve element shape without changing the element count."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "swap_acceptance_tol2"
                label   "Acceptance Tolerance"
                type    float
                default { "-1e-08" }
                disablewhen "{ swap_enabled2 == 0 }"
                range   { -1 0! }
                help    "A swap is kept only if the energy does not rise by more than this amount (negative values allow a small increase)."
                parmtag { "export_disable" "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "swap_max_depth2"
                label   "Max Depth"
                type    integer
                default { "1" }
                disablewhen "{ swap_enabled2 == 0 }"
                range   { 1! 10 }
                help    "How many swap passes may run within one time step."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "split_4"
            label   "Smoothing"

            parm {
                name    "smooth_enabled"
                label   "Enable Vertex Smoothing"
                type    toggle
                default { "0" }
                help    "Allow vertex smoothing (moving interior vertices to improve element quality)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "smooth_acceptance_tol"
                label   "Acceptance Tolerance"
                type    float
                default { "-1e-08" }
                disablewhen "{ smooth_enabled == 0 }"
                range   { -1 0! }
                help    "A smoothing move is kept only if the energy does not rise by more than this amount (negative values allow a small increase)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "smooth_max_iters"
                label   "Max Iterations"
                type    integer
                default { "1" }
                disablewhen "{ smooth_enabled == 0 }"
                range   { 1! 10 }
                help    "How many smoothing iterations may run within one time step."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "split_5"
            label   "Local Relaxation"

            parm {
                name    "local_mesh_n_ring"
                label   "Size of n-ring"
                type    integer
                default { "2" }
                range   { 0 10 }
                help    "Size of the neighborhood (number of element rings around an edit) that is re-solved locally to judge whether a mesh edit is accepted. Larger is more accurate but slower."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "local_mesh_rel_area"
                label   "Min area"
                type    log
                default { "0.01" }
                range   { 0! 1 }
                help    "Minimum area (relative to the whole mesh) of that local neighborhood."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "max_nl_iterations"
                label   "Max NL Solver iters"
                type    integer
                default { "1" }
                range   { 1! 10 }
                help    "Newton iterations spent on each local re-solve before the accept/reject check. 1 is usually enough."
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    group {
        name    "Main_4"
        label   "Time"

        parm {
            name    "quasistatic"
            label   "Quasistatic?"
            type    toggle
            default { "0" }
            help    "On = ignore inertia: each time step finds the static equilibrium for the loads at that time (good for slow loading, no vibrations, no mass needed). Off = full dynamics with inertia and the chosen integrator (needs density; bodies can move, bounce and oscillate)."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm10"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "t0"
            label   "Start Time"
            type    float
            default { "0" }
            range   { 0! 10 }
            help    "Simulation time at the first step (time units). Expressions in boundary conditions see t starting from this value."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "labelparm3"
            label   "Message"
            type    label
            default { "Must choose ONLY 2 of the following, otherwise first 2 will be used:" }
            parmtag { "sidefx::look" "block" }
        }
        parm {
            name    "end_time_bool"
            label   "End Time"
            type    toggle
            joinnext
            default { "1" }
            help    "Specify the end time. Choose exactly two of End Time, Time Increment and # of Timesteps; the third is derived (if all three are on, End Time and Time Increment win)."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "tend"
            label   "End Time"
            type    log
            nolabel
            default { "5" }
            disablewhen "{ end_time_bool != 1 }"
            hidewhen "{ end_time_bool != 1 }"
            range   { 0! 100 }
            help    "Time at which the simulation stops (time units)."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "time_inc_bool"
            label   "Time Increment"
            type    toggle
            joinnext
            default { "1" }
            help    "Specify the time step dt. Choose exactly two of End Time, Time Increment and # of Timesteps."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "dt"
            label   "dt"
            type    log
            nolabel
            default { "0.025" }
            disablewhen "{ time_inc_bool != 1 }"
            hidewhen "{ time_inc_bool != 1 }"
            range   { 0! 10 }
            help    "Size of each time step (time units). Smaller steps follow fast motion and hard contact more accurately but cost more steps; the semi-implicit contact mode tolerates larger steps than classic IPC."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "num_timesteps_bool"
            label   "# of Timesteps"
            type    toggle
            joinnext
            default { "0" }
            help    "Specify the number of time steps instead of the end time or the step size. Choose exactly two of the three."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "num_timesteps"
            label   "# of Timesteps"
            type    log
            nolabel
            default { "200" }
            disablewhen "{ num_timesteps_bool != 1 }"
            hidewhen "{ num_timesteps_bool != 1 }"
            range   { 0! 10000 }
            help    "Number of time steps to run (whole number)."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm6"
            label   "Separator"
            type    separator
            default { "" }
        }
        parm {
            name    "integrator"
            label   "Integrator"
            type    ordinal
            default { "0" }
            menu {
                "ImplicitEuler"     "ImplicitEuler"
                "BDF1"              "BDF1"
                "BDF2"              "BDF2"
                "BDF3"              "BDF3"
                "BDF4"              "BDF4"
                "BDF5"              "BDF5"
                "BDF6"              "BDF6"
                "ImplicitNewmark"   "ImplicitNewmark"
            }
            help    "Time-stepping scheme for dynamic runs (ignored when Quasistatic is on). ImplicitEuler = most stable, some numerical damping; BDF2 or higher = more accurate, less damping; ImplicitNewmark = classic structural dynamics with tunable beta/gamma."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "newmark_beta"
            label   "Newmark Beta"
            type    float
            default { "0.25" }
            disablewhen "{ integrator != ImplicitNewmark }"
            hidewhen "{ integrator != ImplicitNewmark }"
            range   { 0 0.5 }
            help    "Newmark beta parameter. 0.25 (with gamma 0.5) is the standard unconditionally stable, non-dissipative average-acceleration scheme."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "newmark_gamma"
            label   "Newmark Gamma"
            type    float
            default { "0.5" }
            disablewhen "{ integrator != ImplicitNewmark }"
            hidewhen "{ integrator != ImplicitNewmark }"
            range   { 0 1 }
            help    "Newmark gamma parameter. 0.5 introduces no numerical damping; larger values damp high-frequency vibrations."
            parmtag { "script_callback_language" "python" }
        }
    }

    group {
        name    "Main_5"
        label   "Contact"

        parm {
            name    "enable"
            label   "Enable Contact"
            type    toggle
            default { "1" }
            help    "Detect and resolve collisions between bodies (and self-collisions) with the IPC barrier method: surfaces are kept a small gap apart and can never pass through each other. Turn off if nothing can touch, to save the collision-detection cost."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "sepparm11"
            label   "Spacer"
            type    separator
            default { "" }
            parmtag { "sidefx::layout_height" "small" }
            parmtag { "sidefx::look" "blank" }
        }
        group {
            name    "barrier_tab"
            label   "Barrier (ICP)"
            disablewhen "{ enable == 0 }"
            hidewhen "{ enable == 0 }"

            parm {
                name    "adapt_dhat"
                label   "Adaptive dhat"
                type    toggle
                joinnext
                default { "0" }
                help    "Let the barrier activation distance shrink locally where surfaces are already very close (adaptive dhat, used with the GCP formulation). Off = one global dhat everywhere."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "min_dist_ratio"
                label   "Min dist ratio"
                type    log
                default { "0.5" }
                disablewhen "{ adapt_dhat == 0 }"
                range   { 0! 1 }
                help    "With adaptive dhat: the local activation distance is this fraction of the current gap. Smaller values let surfaces get closer before the barrier acts."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "dhat"
                label   "dhat"
                type    log
                default { "0.001" }
                disablewhen "{ enable == 0 }"
                range   { 1e-12 10 }
                help    "Barrier activation distance (length units): surfaces closer than dhat start repelling each other, so they always stay at least a fraction of dhat apart. Use about 1e-3 of your model size (Calc Min Edge shows the smallest mesh edge as a guide); much smaller values make contact harder to solve, much larger ones leave a visible gap."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sepparm15"
                label   "Spacer"
                type    separator
                default { "" }
                parmtag { "sidefx::layout_height" "small" }
                parmtag { "sidefx::look" "blank" }
            }
            parm {
                name    "min_edge_button"
                label   "Calc Min Edge"
                type    button
                joinnext
                default { "0" }
                disablewhen "{ enable == 0 }"
                help    "Measure the shortest edge of all loaded meshes and show it in Min Edge Length, to help choose dhat (dhat should be well below the smallest edge)."
                parmtag { "script_callback" "hou.pwd().hm().deter_min_edge(kwargs)" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "min_edge"
                label   "Min Edge Length"
                type    string
                nolabel
                default { "-1" }
                disablewhen "{ enable == 0 }"
                help    "Shortest mesh edge found by Calc Min Edge (length units). Read-only reference; -1 means not computed yet."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sepparm12"
                label   "Spacer"
                type    separator
                default { "" }
                parmtag { "sidefx::layout_height" "small" }
                parmtag { "sidefx::look" "blank" }
            }
            parm {
                name    "barrier_mode"
                label   "Barrier Stiffness Mode"
                type    ordinal
                default { "0" }
                disablewhen "{ enable == 0 }"
                menu {
                    "semi_implicit" "Semi-Implicit (per-contact, recommended)"
                    "adaptive"      "Adaptive (classic IPC)"
                    "fixed"         "Fixed Value"
                }
                help    "How the strength of the contact barrier is chosen. Semi-Implicit (recommended): each contact gets its own stiffness from the local material stiffness, kept in a healthy gap band by a global trim controller with stall recovery, and carried over between steps (force continuation) -- the robust choice for stiff or quasistatic contact. Adaptive: classic IPC heuristic that grows the stiffness when surfaces get too close. Fixed: one value you set."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "barrier_stiffness"
                label   "Fixed Barrier Stiffness"
                type    log
                default { "1e8" }
                disablewhen "{ enable == 0 } { barrier_mode != fixed }"
                range   { 1000 1e+30 }
                help    "The single barrier stiffness used in Fixed mode (stress-like units). Rule of thumb: 10-100 times your largest Young's modulus. Too low lets surfaces get very close; too high makes the solve ill-conditioned."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "initial_barrier_stiffness"
                label   "Initial Barrier Stiffness"
                type    log
                default { "1" }
                disablewhen "{ enable == 0 } { barrier_mode != adaptive }"
                range   { 1 1e+30 }
                help    "Starting stiffness for the classic Adaptive heuristic; PolyFEM then raises it automatically when the gap gets too small."
                parmtag { "script_callback_language" "python" }
            }
            groupcollapsible {
                name    "semi_implicit_folder"
                label   "Semi-Implicit Options"
                disablewhentab "{ barrier_mode != semi_implicit }"

                parm {
                    name    "si_trim_lower"
                    label   "Trim Band Lower"
                    type    log
                    default { "0.5" }
                    range   { 1e-08 1 }
                    help    "Lower edge of the gap band, as a fraction of dhat^2. When the average active gap drops below it the global stiffness trim is raised, keeping contacts from being crushed. 0.5 actively centers the gap high in the band and stiffens the barrier as the load grows (essential for obstacle-driven contact); lower values turn the controller into a collapse-only safety net."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_trim_upper"
                    label   "Trim Band Upper"
                    type    float
                    default { "0.9" }
                    range   { 0.01 1 }
                    help    "Upper edge of the gap band, as a fraction of dhat^2. When the average active gap sits above it the global trim is lowered so the barrier stops dominating the elasticity."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_trim_factor"
                    label   "Trim Factor"
                    type    float
                    default { "2" }
                    range   { 1.1 16 }
                    help    "Multiplier by which the global trim moves at each controller step (up when the gap collapses, down when it is pinned above the band). 2 doubles/halves; larger values react faster but less smoothly."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_kappa_spread"
                    label   "Stiffness Spread Cap"
                    type    log
                    default { "10000" }
                    range   { 10 1e+08 }
                    help    "Allowed spread of the per-contact stiffnesses within one refresh: each is capped at this multiple of the batch median and floored at the median divided by it. Guards against crushed-element Hessian blow-ups. For thin structures under extreme stretch, larger values (1e8) let taut-membrane hotspots keep their full local stiffness."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_conditioning_cap"
                    label   "Conditioning Cap"
                    type    log
                    default { "1000" }
                    range   { 10 1e+06 }
                    help    "When contact first appears unloaded (no force balance to calibrate against), cap the barrier's effective stiffness at this multiple of the largest system-Hessian entry. Bounds the dynamic range of the linear system until the load provides a calibration signal. Dimensionless; raise to loosen."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_controller_interval"
                    label   "Controller Interval"
                    type    integer
                    default { "30" }
                    range   { 0 200 }
                    help    "How many Newton iterations between downward trim steps while the gap stays pinned above the band inside a solve. 0 disables the in-solve downward step."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_refresh_interval"
                    label   "Refresh Interval"
                    type    integer
                    default { "0" }
                    range   { 0 50 }
                    help    "0 (recommended) = re-estimate per-contact stiffness only at the start of each solve and on stall restarts, keeping the objective fixed within a solve. N > 0 additionally refreshes every N Newton iterations (experimental)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_restart_enabled"
                    label   "Stall Restart"
                    type    toggle
                    default { "1" }
                    help    "Detect a stalled line search (tiny steps for several iterations) and restart the solve with the barrier stiffness retuned. Leave on; it rescues solves that would otherwise grind to a halt."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_alpha_threshold"
                    label   "Stall Alpha Threshold"
                    type    log
                    default { "0.01" }
                    disablewhen "{ si_restart_enabled == 0 }"
                    range   { 1e-08 0.1 }
                    help    "A Newton iteration counts as stalled when its line-search step is smaller than this fraction of a full step (0.01 = 1%)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_patience"
                    label   "Stall Patience"
                    type    integer
                    default { "5" }
                    disablewhen "{ si_restart_enabled == 0 }"
                    range   { 1 50 }
                    help    "Number of consecutive stalled iterations before a restart is triggered."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_soft_iteration_limit"
                    label   "Soft Iteration Limit"
                    type    integer
                    default { "100" }
                    disablewhen "{ si_restart_enabled == 0 }"
                    range   { -1 500 }
                    help    "Restart with retuned stiffness after this many Newton iterations even without a detected stall (-1 disables). Keep it below the solver's hard Max Iterations."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_max_restarts"
                    label   "Max Restarts"
                    type    integer
                    default { "20" }
                    disablewhen "{ si_restart_enabled == 0 }"
                    range   { 0 50 }
                    help    "Maximum number of stall restarts per solve. If nothing changes between two restarts the solver stops early instead of repeating identical attempts."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_min_iterations"
                    label   "Stall Min Iterations"
                    type    integer
                    default { "5" }
                    disablewhen "{ si_restart_enabled == 0 }"
                    range   { 0 100 }
                    help    "Newton iterations that must have run before a stall may trigger a restart, so a slow start is not mistaken for a stall."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_stall_trim_factor"
                    label   "Stall Trim Factor"
                    type    float
                    default { "2" }
                    disablewhen "{ si_restart_enabled == 0 }"
                    range   { 1.1 16 }
                    help    "Multiplier applied to the global trim at a stall restart (up when the gap is collapsed, down when the barrier is too stiff)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_sep_continuation"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "si_force_continuation"
                    label   "Force Continuation"
                    type    toggle
                    default { "1" }
                    help    "Carry each contact's stiffness over from the end of the previous step instead of re-estimating it (on, recommended). This keeps the contact forces exactly continuous across steps -- the published result of a step is a true equilibrium of the state the next step starts from -- and removes the 5-50% force jumps re-estimation caused. New contacts still get the local-stiffness estimate when they first appear. Off restores the older re-estimating behavior."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_continuation_max_ratio"
                    label   "Continuation Max Ratio"
                    type    float
                    default { "0" }
                    disablewhen "{ si_force_continuation == 0 }"
                    range   { 0 16 }
                    help    "With Force Continuation: 0 = pure continuation (a contact's stiffness never changes once set). A value r > 1 lets the fresh local-stiffness estimate pull a carried-over stiffness by at most a factor r per step, e.g. 2 allows halving or doubling. Rarely needed."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_coefficient_identity"
                    label   "Coefficient Identity"
                    type    ordinal
                    default { "0" }
                    menu {
                        "parent"    "Parent Candidate (recommended)"
                        "stencil"   "Built Stencil (historical)"
                    }
                    help    "What a contact stiffness is attached to. Parent Candidate (recommended): the pair of mesh features (point/edge in 2D, point/triangle or edge/edge in 3D) that generated the contact, so the stiffness follows the contact when the closest sub-feature switches and the contact energy stays continuous. Built Stencil: the historical keying on the exact sub-feature, kept only for comparison."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "si_trial_displacement_cap"
                    label   "Trial Displacement Cap"
                    type    float
                    default { "50" }
                    range   { 1 1000 }
                    help    "Largest surface displacement a single Newton trial step may propose, in multiples of dhat. Caps the collision-detection sweep so a wild step cannot cost enormous broad-phase time or memory. 50 is a safe default; the cap never affects converged results."
