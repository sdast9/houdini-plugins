                default { "0.001" }
                disablewhen "{ enable == 0 }"
                range   { 1e-06 1 }
                help    "Friction smoothing velocity (length per time): sliding slower than this is treated as sticking with a smooth transition. Smaller values are closer to true stick/slip but harder to solve; a few percent of the typical sliding speed works well."
