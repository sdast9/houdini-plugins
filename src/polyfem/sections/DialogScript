            }
            parm {
                name    "CCD_tolerance"
                label   "CCD tolerance"
                type    float
                default { "1e-06" }
                disablewhen "{ enable == 0 }"
                range   { 0 10 }
                help    "Accuracy of continuous collision detection when computing how far a step may move before surfaces would touch. Smaller = more accurate but slower; 1e-6 is standard."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "ccd_max_iterations"
                label   "CCD Max Iterations"
                type    intlog
                default { "1e+06" }
                disablewhen "{ enable == 0 }"
                range   { 1000 1e+12 }
                help    "Iteration cap for the continuous collision detection root finder. The default is large enough for all practical cases."
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    group {
        name    "Main_6"
        label   "Solver"

        group {
            name    "linear"
            label   "Linear"

            parm {
                name    "solver"
                label   "Solver"
                type    ordinal
                default { "0" }
                menu {
                    "auto"                                  "Automatic (PolyFEM default)"
                    "Eigen::SimplicialLDLT"                 "Eigen::SimplicialLDLT (direct)"
                    "Eigen::SparseLU"                       "Eigen::SparseLU (direct)"
                    "Eigen::CholmodSupernodalLLT"           "Eigen::CholmodSupernodalLLT (direct)"
                    "Eigen::AccelerateLLT"                  "Eigen::AccelerateLLT (direct, macOS)"
                    "Eigen::AccelerateLDLT"                 "Eigen::AccelerateLDLT (direct, macOS)"
                    "Eigen::UmfPackLU"                      "Eigen::UmfPackLU (direct)"
                    "Eigen::SuperLU"                        "Eigen::SuperLU (direct)"
                    "Eigen::PardisoLDLT"                    "Eigen::PardisoLDLT (direct, MKL)"
                    "Eigen::PardisoLLT"                     "Eigen::PardisoLLT (direct, MKL)"
                    "Eigen::PardisoLU"                      "Eigen::PardisoLU (direct, MKL)"
                    "Pardiso"                               "Pardiso (direct, MKL)"
                    "Hypre"                                 "Hypre (iterative, multigrid)"
                    "AMGCL"                                 "AMGCL (iterative, multigrid)"
                    "Eigen::ConjugateGradient"              "Eigen::ConjugateGradient (iterative)"
                    "Eigen::LeastSquaresConjugateGradient"  "Eigen::LeastSquaresConjugateGradient (iterative)"
                    "Eigen::BiCGSTAB"                       "Eigen::BiCGSTAB (iterative)"
                    "Eigen::GMRES"                          "Eigen::GMRES (iterative)"
                    "Eigen::DGMRES"                         "Eigen::DGMRES (iterative)"
                    "Eigen::MINRES"                         "Eigen::MINRES (iterative)"
                }
                help    "Direct or iterative method for the linear system solved at each Newton iteration. Automatic lets PolyFEM pick the best direct solver compiled into your binary (recommended). Direct solvers (LDLT/LLT/LU) are robust and exact; iterative ones (CG, GMRES, Hypre, AMGCL) use less memory on very large meshes but need a preconditioner and tolerance. Options marked MKL or macOS only exist in builds with that library: if the binary you point at was not built with the solver you pick, PolyFEM prints a warning in the log and falls back to its own default instead of stopping (the HDA sets enable_overwrite_solver for you)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "max_iter"
                label   "Max Iterations"
                type    intlog
                default { "1000" }
                disablewhen "{ solver != Eigen::ConjugateGradient solver != Eigen::LeastSquaresConjugateGradient solver != Eigen::DGMRES solver != Eigen::BiCGSTAB solver != Eigen::GMRES solver != Eigen::MINRES }"
                hidewhen "{ solver != Eigen::ConjugateGradient solver != Eigen::LeastSquaresConjugateGradient solver != Eigen::DGMRES solver != Eigen::BiCGSTAB solver != Eigen::GMRES solver != Eigen::MINRES }"
                range   { 1 100000 }
                help    "Maximum iterations of the iterative linear solver per Newton step. If it is reached the step is inaccurate; raise it or tighten the preconditioner."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "tolerance"
                label   "Tolerance"
                type    log
                default { "1e-12" }
                disablewhen "{ solver != Eigen::ConjugateGradient solver != Eigen::LeastSquaresConjugateGradient solver != Eigen::DGMRES solver != Eigen::BiCGSTAB solver != Eigen::GMRES solver != Eigen::MINRES }"
                hidewhen "{ solver != Eigen::ConjugateGradient solver != Eigen::LeastSquaresConjugateGradient solver != Eigen::DGMRES solver != Eigen::BiCGSTAB solver != Eigen::GMRES solver != Eigen::MINRES }"
                range   { 1e-20 1 }
                help    "Relative residual at which the iterative Eigen solver stops (smaller = more accurate linear solves; 1e-12 keeps Newton's convergence intact)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "precond"
                label   "Preconditioner"
                type    ordinal
                default { "0" }
                disablewhen "{ solver != Eigen::ConjugateGradient solver != Eigen::LeastSquaresConjugateGradient solver != Eigen::DGMRES solver != Eigen::BiCGSTAB solver != Eigen::GMRES solver != Eigen::MINRES }"
                hidewhen "{ solver != Eigen::ConjugateGradient solver != Eigen::LeastSquaresConjugateGradient solver != Eigen::DGMRES solver != Eigen::BiCGSTAB solver != Eigen::GMRES solver != Eigen::MINRES }"
                menu {
                    "Eigen::IdentityPreconditioner"             "Eigen::IdentityPreconditioner"
                    "Eigen::DiagonalPreconditioner"             "Eigen::DiagonalPreconditioner"
                    "Eigen::IncompleteCholesky"                 "Eigen::IncompleteCholesky"
                    "Eigen::LeastSquareDiagonalPreconditioner"  "Eigen::LeastSquareDiagonalPreconditioner"
                    "Eigen::IncompleteLUT"                      "Eigen::IncompleteLUT"
                }
                help    "Preconditioner for the iterative Eigen solvers. Diagonal is cheap; Incomplete Cholesky (symmetric) or Incomplete LUT usually converge in far fewer iterations."
                parmtag { "export_disable" "1" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "mtype"
                label   "Matrix Type"
                type    ordinal
