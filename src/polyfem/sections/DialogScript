                        default { "1" }
                        disablewhen "{ solver != AMGCL } { relax_type != chebyshev }"
                        hidewhen "{ solver != AMGCL } { relax_type != chebyshev }"
                        range   { 0 10 }
                        help    "Scale the matrix before building the AMGCL hierarchy (improves robustness for badly scaled systems)."
                        parmtag { "script_callback_language" "python" }
                    }
                }

            }

        }

        parm {
            name    "solver_nl"
            label   "Solver"
            type    ordinal
            default { "0" }
            menu {
                "Newton"                    "Newton (recommended)"
                "DenseNewton"               "Dense Newton"
                "GradientDescent"           "Gradient Descent"
                "ADAM"                      "ADAM"
                "StochasticADAM"            "Stochastic ADAM"
                "StochasticGradientDescent" "Stochastic Gradient Descent"
                "L-BFGS"                    "L-BFGS"
                "BFGS"                      "BFGS"
                "L-BFGS-B"                  "L-BFGS-B"
                "MMA"                       "MMA"
            }
            help    "Method used to minimize the total energy at each step. Newton (recommended) uses second derivatives and converges in few iterations; it falls back to regularized Newton and gradient descent automatically when a step fails. The other methods are first-order or quasi-Newton alternatives that need many more iterations and are provided for experiments."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "history_size"
            label   "History Size"
            type    integer
            default { "6" }
            disablewhen "{ solver_nl != L-BFGS solver_nl != L-BFGS-B }"
            hidewhen "{ solver_nl != L-BFGS solver_nl != L-BFGS-B }"
            range   { 1 50 }
            help    "Number of previous steps L-BFGS keeps to approximate curvature. 6-20 is typical; more memory, better steps."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "residual_tolerance"
            label   "Residual Tolerance"
            type    log
            default { "1e-05" }
            disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            range   { 1e-12 1 }
            help    "Newton: accept the linear solve when its relative residual is below this value. The default 1e-5 is fine for direct solvers; loosen it only for iterative solvers."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "reg_weight_min"
            label   "Min Reg Weight"
            type    log
            default { "1e-08" }
            disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            range   { 1e-15 1 }
            help    "Newton: smallest regularization (identity added to the Hessian, in Hessian units) tried when a plain Newton step fails. Regularization makes steps shorter but safer."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "reg_weight_max"
            label   "Max Reg Weight"
            type    log
            default { "1e+08" }
            disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            range   { 1 1e+15 }
            help    "Newton: largest regularization tried before giving up on the regularized strategy and falling back to gradient descent."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "reg_weight_inc"
            label   "Reg Weight Increment"
            type    float
            default { "10" }
            disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
            range   { 1.5 100 }
            help    "Newton: factor by which the regularization grows after each failed regularized step (10 = one decade at a time)."
            parmtag { "export_disable" "1" }
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "adam_alpha"
            label   "Alpha"
            type    float
            default { "0.001" }
            disablewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            hidewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            range   { 0 1 }
            help    "ADAM learning rate (step size). Larger moves faster but may overshoot."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "adam_beta1"
            label   "Beta 1"
            type    float
            default { "0.9" }
            disablewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            hidewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            range   { 0 1 }
            help    "ADAM decay rate of the first-moment (gradient average) estimate; 0.9 is standard."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "adam_beta2"
            label   "Beta 2"
            type    float
            default { "0.999" }
            disablewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            hidewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            range   { 0 1 }
            help    "ADAM decay rate of the second-moment (squared gradient) estimate; 0.999 is standard."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "adam_epsilon"
            label   "Epsilon"
            type    float
            default { "1e-08" }
            disablewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            hidewhen "{ solver_nl != ADAM solver_nl != StochasticADAM }"
            range   { 0 1 }
            help    "ADAM small constant that prevents division by zero in the update; 1e-8 is standard."
            parmtag { "script_callback_language" "python" }
        }
        parm {
            name    "erase_component_probability"
            label   "Erase Component Probability"
            type    float
            default { "0.3" }
            disablewhen "{ solver_nl != StochasticADAM solver_nl != StochasticGradientDescent }"
            hidewhen "{ solver_nl != StochasticADAM solver_nl != StochasticGradientDescent }"
            range   { 0 1 }
            help    "Stochastic methods: probability that each unknown is left out of a given update, which randomizes the descent. 0.3 = update ~70% of the unknowns per iteration."
            parmtag { "script_callback_language" "python" }
        }
        group {
            name    "_folder0_2"
            label   "Line Search"
            grouptag { "sidefx::switcher" "folder0_2" }

            parm {
                name    "use_grad_norm_tol"
                label   "Grad Norm Tol"
                type    log
                default { "1e-06" }
                range   { 1e-15 0.1 }
                help    "When the gradient norm is already below this value (times the problem's force scale), the line search judges steps by the gradient norm instead of the energy, because energy differences near convergence are lost to floating-point roundoff. 1e-6 is standard; 0 disables the switch."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "min_step_size"
                label   "Min Step Size"
                type    log
                default { "1e-10" }
                range   { 1e-15 1e-05 }
                help    "Smallest fraction of a Newton step the line search will try before declaring the step failed (which triggers the next fallback strategy)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "max_step_size_iter"
                label   "Max Step Size Iter"
                type    integer
                default { "30" }
                range   { 1 100 }
                help    "Maximum number of step-halvings the line search performs in normal strategies."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "min_step_size_final"
                label   "Min Step Size Final"
                type    log
                default { "1e-20" }
                range   { 1e-30 1e-05 }
                help    "Smallest step fraction allowed on the last-resort strategy (gradient descent), before the solve is declared failed."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "max_step_size_iter_final"
                label   "Max Step Size Iter Final"
                type    intlog
                default { "100" }
                range   { 1 1000 }
                help    "Maximum number of step-halvings on the last-resort strategy."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "default_init_step_size"
                label   "Default Init Step Size"
                type    float
                default { "1" }
                range   { 0 1 }
                help    "Fraction of the full Newton step the line search tries first (1 = the full step, always right for Newton)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "step_ratio"
                label   "Step Ratio"
                type    log
                default { "0.5" }
                range   { 0.01 1 }
                help    "Factor by which the step is shrunk each time the line search rejects it (0.5 = halve it)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "method"
                label   "Method"
                type    ordinal
                default { "1" }
                menu {
                    "Armijo"        "Armijo"
                    "RobustArmijo"  "Robust Armijo (recommended)"
                    "Backtracking"  "Backtracking"
                    "None"          "None (full steps, unsafe)"
                }
                help    "Rule the line search uses to accept a trial step. Robust Armijo (recommended) is Armijo's sufficient-decrease test made safe against roundoff near convergence. Armijo is the plain test; Backtracking only asks for any energy decrease; None takes full steps blindly and can pass through contact or diverge -- use it only for experiments."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "armijo_c"
                label   "Armijo c"
                type    log
                default { "0.0001" }
                disablewhen "{ method != Armijo method != RobustArmijo }"
                hidewhen "{ method != Armijo method != RobustArmijo }"
                range   { 0 1 }
                help    "Armijo constant c: a step is accepted if the energy drops by at least c times the drop predicted by the gradient. 1e-4 is the textbook value; larger is stricter."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "delta_relative_tolerance"
                label   "Delta Relative Tolerance"
                type    float
                default { "0.1" }
                disablewhen "{ method != RobustArmijo }"
                hidewhen "{ method != RobustArmijo }"
                range   { 0 1 }
                help    "Robust Armijo: when the energy change is smaller than this fraction of the energy itself, the test switches to a gradient-based estimate that is not swamped by roundoff. 0.1 is standard."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "armijo_roundoff_tolerance"
                label   "Roundoff Tolerance"
                type    log
                default { "2.220446049250313e-16" }
                disablewhen "{ method != Armijo method != RobustArmijo }"
                hidewhen "{ method != Armijo method != RobustArmijo }"
                range   { 0 1e-08 }
                help    "Roundoff floor of the energy for Armijo and Robust Armijo: if the energy change is within this fraction of (1 + |energy|), it cannot be trusted and the step is instead accepted when the gradient norm decreases. The default is machine precision (2.2e-16); 0 disables this fallback. Together with Grad Norm Tol this prevents solves from stalling on floating-point noise."
                parmtag { "script_callback_language" "python" }
            }
        }


        group {
            name    "_folder0_2_2"
            label   "Nonlinear Settings"

            parm {
                name    "labelparm2"
                label   "Stopping criteria"
                type    label
                default { "Stopping criteria" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "first_grad_norm_tol"
                label   "First Gradient Norm Tolerance"
                type    log
                default { "1e-12" }
                range   { 1e-20 1 }
                help    "Skip the solve entirely when the initial gradient norm is already below this value (the state is already in equilibrium)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "x_delta"
                label   "X Delta Tolerance"
                type    log
                default { "0" }
                range   { 1e-15 1 }
                help    "Stop when the change of the unknowns in one iteration is smaller than this (scaled by the problem size). 0 = do not use this criterion."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "rel_x_delta_tol"
                label   "Relative X Delta Tolerance"
                type    log
                default { "0" }
                range   { 0 1 }
                help    "Stop when the change of the unknowns in one iteration has dropped to this fraction of the first iteration's change. 0 = do not use this criterion. Like X Delta, stopping this way is not proof of equilibrium, so it only counts as convergence when Allow Non-Gradient Convergence is on."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "grad_norm"
                label   "Gradient Norm Tolerance"
                type    log
                default { "1e-10" }
                range   { 1e-20 1 }
                help    "Main convergence criterion: stop when the gradient (residual force) norm, scaled by the problem's force scale, falls below this value. Smaller = more accurate equilibrium, more iterations; 1e-10 is tight, 1e-6 is loose."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "norm_type"
                label   "Gradient Norm Type"
                type    ordinal
                default { "1" }
                menu {
                    "Euclidean" "Euclidean (unscaled)"
                    "L2"        "L2 (scaled, default)"
                    "Linf"      "Linf (largest component, scaled)"
                }
                help    "Which norm of the gradient (residual force) is compared with Gradient Norm Tolerance, and how PolyFEM scales it to be unit-free. L2 (default) is scaled by the characteristic force and length so the tolerance means the same on any mesh or unit system; Linf uses the largest single component, scaled by the characteristic force; Euclidean is the raw, unscaled vector norm and is only meaningful if you know the units of your gradient."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "rel_grad_norm_tol"
                label   "Relative Gradient Norm Tolerance"
                type    log
                default { "1e-10" }
                range   { 0 1 }
                help    "Also stop when the gradient norm has dropped to this fraction of its value at the start of the solve (1e-10 = ten orders of magnitude). Works alongside the absolute Gradient Norm Tolerance: whichever is met first ends the solve, and both count as genuine convergence. 0 = do not use this criterion."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "max_iterations"
                label   "Max Iterations"
                type    intlog
                default { "500" }
                range   { 1 100000 }
                help    "Hard limit on Newton iterations per solve. If it is reached without convergence the run fails (unless Allow Out of Iterations is on)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "iterations_per_strategy"
                label   "Iterations per Strategy"
                type    intlog
                default { "5" }
                range   { 1 100000 }
                help    "How many iterations a fallback strategy (regularized Newton, gradient descent) runs before the solver tries to return to plain Newton."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "allow_out_of_iterations"
                label   "Allow Out of Iterations"
                type    toggle
                default { "0" }
                help    "Continue the simulation with the best available state when Max Iterations is reached instead of stopping with an error. The result of such a step is not converged; the log records it."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "allow_non_grad_convergence"
                label   "Allow Non-Gradient Convergence"
                type    toggle
                default { "0" }
                help    "Count a stop on the X Delta, Relative X Delta, f Delta or Newton Decrement criteria as a successful (converged) solve. Off (default): only a small gradient norm counts as convergence; a stop on those other criteria is logged as an error and the solve is reported as interrupted (not converged)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "force_psd_projection"
                label   "Force PSD Projection"
                type    toggle
                default { "0" }
                disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
                hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
                help    "Always project element Hessians to positive semi-definite, even on the first attempt. Guarantees a descent direction at the cost of slower (linear) convergence near the solution."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "use_psd_projection"
                label   "Use PSD Projection"
                type    toggle
                default { "1" }
                disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
                hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
                help    "Allow projecting element Hessians to positive semi-definite when a plain Newton step is not a descent direction (standard IPC practice). Turning this off can make solves fail on buckling or snapping configurations."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "use_psd_projection_reg"
                label   "Use PSD Projection in Regularized"
                type    toggle
                default { "1" }
                disablewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
                hidewhen "{ solver_nl != Newton solver_nl != DenseNewton }"
                help    "Also project element Hessians to positive semi-definite inside the regularized-Newton fallback strategy."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "labelparm"
                label   "Advanced stopping criteria"
                type    label
                default { "Advanced stopping criteria" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "f_delta"
                label   "f Delta Tolerance"
                type    log
                default { "0" }
                range   { 0 0.1 }
                help    "Stop when the energy changes by less than this over f Delta Step Count consecutive iterations. 0 = do not use this criterion."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "f_delta_step_tol"
                label   "f Delta Step Count"
                type    intlog
                default { "100" }
                range   { 1 1000 }
                help    "Number of consecutive iterations the energy change must stay below f Delta before stopping on that criterion."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "derivative_along_delta_x_tol"
                label   "Descent Direction Tolerance"
                type    log
                default { "1e-16" }
                range   { 0 1e-15 }
                help    "Stop with 'not a descent direction' when the directional derivative along the proposed step is above this negative threshold (i.e. the step would not lower the energy). The tiny default only catches genuine ascent."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "newton_decrement_tol"
                label   "Newton Decrement Tolerance"
                type    log
                default { "0" }
                range   { 0 1 }
                help    "Stop when the Newton decrement 1/2 dx.H.dx (the energy decrease the quadratic model predicts for the next step) falls below this value. 0 = off (default); that is also why the log prints 1/2dx^THdx=nan on every solve: the quantity is simply not computed. Counts as convergence only when Allow Non-Gradient Convergence is on."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "_folder0_2_3"
            label   "Augmented Lagrangian"

            parm {
                name    "al_hessian_scaled"
                label   "Hessian-Scaled Initial Weight"
                type    toggle
                default { "1" }
                help    "Set the initial penalty weight of the boundary-condition (augmented Lagrangian) phase from the elastic stiffness: multiplier times the largest Hessian entry, so the penalty dominates the problem curvature regardless of units. Recommended; otherwise a fixed Initial Weight is used."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_weight_multiplier"
                label   "Weight Multiplier"
                type    log
                default { "10" }
                disablewhen "{ al_hessian_scaled == 0 }"
                range   { 0.1 1e+06 }
                help    "Multiplier applied to the largest elastic Hessian entry to get the initial penalty weight when Hessian-Scaled is on. 10 is a good default; raise it if boundary conditions are not being met."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_initial_weight"
                label   "Initial Weight"
                type    log
                default { "1e6" }
                disablewhen "{ al_hessian_scaled == 1 }"
                range   { 1 1e+20 }
                help    "Fixed initial penalty weight of the boundary-condition phase (stress-like units) when Hessian-Scaled is off."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_scaling"
                label   "Scaling"
                type    float
                default { "2" }
                range   { 0 10 }
                help    "Factor by which the penalty weight grows each time the boundary conditions are still not satisfied (2 = doubling)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_max_weight"
                label   "Max Weight"
                type    log
                default { "1e+30" }
                range   { 1 1e+30 }
                help    "Ceiling for the penalty weight growth; if it is reached the boundary conditions cannot be enforced more strictly."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_eta"
                label   "Eta"
                type    float
                default { "0.99" }
                range   { 0 1 }
                help    "Progress ratio: if the boundary-condition error shrinks by less than this fraction between rounds, the weight is increased instead of the Lagrange multipliers. 0.99 favors updating the multipliers."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_lumping"
                label   "Mass Lumping"
                type    ordinal
                default { "0" }
                menu {
                    "row_sum"   "row_sum (default)"
                    "hrz"       "hrz (diagonal scaling)"
                }
                help    "How the mass matrix behind the boundary-condition penalty is reduced to a diagonal (lumped) matrix. row_sum adds up each row (standard); hrz (Hinton-Rock-Zienkiewicz) scales the diagonal to preserve the total mass and stays well conditioned for higher-order elements. PolyFEM switches to hrz by itself when row_sum turns out ill-conditioned, so this rarely needs changing."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "al_max_iterations"
                label   "Max Iterations (AL Phase)"
                type    integer
                default { "500" }
                range   { 1 1000 }
                help    "Newton iteration limit used during the boundary-condition (augmented Lagrangian) phase. Same as Max Iterations unless you change it."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "_folder0_2_4"
            label   "Rayleigh Damping"

            multiparm {
                name    "num_rayleigh"
                label    "Num of Rayleigh Damping Types"

                parm {
                    name    "rayleigh_form#"
                    label   "Form"
                    type    ordinal
                    default { "0" }
                    menu {
                        "elasticity"    "Elasticity"
                        "contact"       "Contact"
                        "friction"      "Friction"
                    }
                    help    "Which energy this damping term acts on: the elastic deformation, the contact forces, or friction."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "stiffness_ratio#"
                    label   "Stiffness Ratio"
                    type    float
                    default { "0.75" }
                    range   { 0 1 }
                    help    "Amount of stiffness-proportional (Rayleigh) damping: the damping matrix is 0.75 * ratio * dt^3 times the stiffness matrix, which mainly damps high-frequency vibrations. 0 = none."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "rayleigh_lagging#"
                    label   "Lagging Iterations"
                    type    integer
                    default { "1" }
                    range   { 0 10 }
                    help    "Number of lagged updates per step of the damping term (it is evaluated with the previous iteration's state)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm4___#"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                parm {
                    name    "sepparm6_#"
                    label   "Separator"
                    type    separator
                    default { "" }
                }
            }

        }

        group {
            name    "_folder0_2_5"
            label   "Advanced"
            tabbreak

            parm {
                name    "max_threads"
                label   "Max Threads"
                type    integer
                default { "0" }
                range   { 0 64 }
                help    "Number of CPU threads PolyFEM may use. 0 = all available cores. Note: with more than one thread, results can differ in the last digits between runs (floating-point summation order); use 1 for bit-reproducible logs."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "cache_size"
                label   "Cache Size"
                type    intlog
                default { "900000" }
                range   { 1 1e+16 }
                help    "Maximum number of elements whose assembly values are cached between iterations. Larger uses more memory but avoids recomputation; the default suits most meshes."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "lump_mass_matrix"
                label   "Lump Mass Matrix"
                type    toggle
                default { "0" }
                help    "Replace the consistent mass matrix by a diagonal one (row sums). Slightly less accurate dynamics but a cheaper, better-conditioned system."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "lagged_regularization_weight"
                label   "Lagged Regularization Weight"
                type    float
                default { "0" }
                range   { 0 10 }
                help    "Adds a small stiffness proportional to this weight to static problems that are otherwise singular (e.g. a body with no boundary conditions floating in space). 0 = off."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "lagged_regularization_iterations"
                label   "Lagged Regularization Iterations"
                type    integer
                default { "1" }
                range   { 0 10 }
                help    "Number of lagged updates of that regularization per solve."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "inversion_method"
                label   "Inversion Detection"
                type    ordinal
                default { "0" }
                menu {
                    "Discrete"      "Discrete (sample points)"
                    "Conservative"  "Conservative (exact, needs MISO build)"
                }
                help    "How PolyFEM checks that no element turns inside-out. Discrete tests the element Jacobians at sample points and is what this build uses; Conservative uses an exact continuous check but requires a PolyFEM build with the MISO library (otherwise Discrete is used with a warning)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "jacobian_threshold"
                label   "Jacobian Threshold"
                type    float
                default { "0" }
                range   { 0 10 }
                help    "Elements whose Jacobian determinant falls below this value are treated as inverted (0 = only truly flipped elements). Raise it to reject nearly degenerate elements earlier."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "labelparm_debug"
                label   "Debugging"
                type    label
                default { "Debugging" }
                parmtag { "sidefx::look" "heading" }
            }
            parm {
                name    "apply_gradient_fd"
                label   "Gradient Finite-Difference Check"
                type    ordinal
                default { "0" }
                menu {
                    "None"                  "None"
                    "DirectionalDerivative" "Directional Derivative"
                    "FullFiniteDiff"        "Full Finite Diff"
                }
                help    "Debugging check: compare the analytic gradient against finite differences every iteration (Directional Derivative = one direction, cheap; Full Finite Diff = every unknown, extremely slow). Leave at None for normal runs."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "gradient_fd_eps"
                label   "Finite-Difference Epsilon"
                type    log
                default { "1e-07" }
                disablewhen "{ apply_gradient_fd == None }"
                hidewhen "{ apply_gradient_fd == None }"
                range   { 0 0.1 }
                help    "Step size used by the finite-difference gradient check."
                parmtag { "script_callback_language" "python" }
            }
        }

    }

    group {
        name    "Main_7"
        label   "Input-Output"

        group {
            name    "folder1"
            label   "Log"

            parm {
                name    "log_level"
                label   "Level"
                type    ordinal
                default { "1" }
                menu {
                    "trace"     "trace"
                    "debug"     "debug"
                    "info"      "info"
                    "warning"   "warning"
                    "error"     "error"
                    "critical"  "critical"
                    "off"       "off"
                }
                help    "How much PolyFEM prints: trace and debug show every solver iteration (large logs, useful for diagnosing contact problems); info shows per-step progress; warning/error only report problems."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "write_log"
                label   "Save Log"
                type    toggle
                default { "0" }
                help    "Also write the log to <working_dir>/output/log.txt (always on for background runs)."
                parmtag { "filechooser_mode" "write" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "log_quiet"
                label   "Quiet"
                type    toggle
                default { "0" }
                help    "Suppress console output entirely; combine with Save Log to keep a file."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "folder1_1"
            label   "Optional Output Files"

            parm {
                name    "output_json"
                label   "Output JSON"
                type    toggle
                default { "0" }
                help    "Write output/output.json with per-run statistics (timings, iteration counts, errors) that other tools can parse."
                parmtag { "filechooser_mode" "write" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "restart_json"
                label   "Restart JSON"
                type    toggle
                default { "0" }
                help    "Write output/restart.json after each step: a small JSON describing the last completed state (time, file index, remesh limits) that can be merged with params.json to continue a run. Restarting also needs the State and Rest Mesh data files."
                parmtag { "filechooser_mode" "write" }
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "folder1_2"
            label   "Paraview"

            parm {
                name    "paraview_file_name"
                label   "File Name"
                type    string
                default { "sim.pvd" }
                help    "Name of the ParaView collection file written in output/ (each step is a .vtu referenced from it). Load this file with the Read PVD node."
                parmtag { "filechooser_mode" "write" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "vismesh_rel_area"
                label   "Upsampling Area"
                type    log
                default { "1e-05" }
                range   { 1e-10 1 }
                help    "Resolution of the visualization mesh for higher-order elements, as a relative area: smaller values subdivide curved elements more finely for display (more, larger files). Has no effect on the solve."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "skip_frame"
                label   "Skip Frames"
                type    integer
                default { "1" }
                range   { 0 10 }
                help    "Write every Nth time step to the ParaView output (1 = every step, 2 = every other step). Reduces output size for long runs."
                parmtag { "script_callback_language" "python" }
            }
            groupcollapsible {
                name    "Options"
                label   "Options"

                parm {
                    name    "use_hdf5"
                    label   "Use HDF5"
                    type    toggle
                    default { "0" }
                    help    "Write the ParaView data in HDF5 format instead of XML .vtu (smaller for large meshes). The Read PVD node expects .vtu, so leave this off for the Houdini workflow."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "materials_fields"
                    label   "Material"
                    type    toggle
                    default { "0" }
                    help    "Export the material parameter fields (E, nu, fiber directions, dispersion ...) with the results. Turning this on disables Minimal Fields, because material array names cannot be whitelisted in advance."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "body_ids_fields"
                    label   "Body IDs"
                    type    toggle
                    default { "0" }
                    help    "Export each element's body id, so the Read PVD node can show or hide individual bodies."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "discr_fields"
                    label   "Discretization Order"
                    type    toggle
                    default { "1" }
                    help    "Export the polynomial order of each element."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "forces_HO_output"
                    label   "Force High Order"
                    type    toggle
                    default { "0" }
                    help    "Force writing of the high-order mesh even for output types where PolyFEM would normally refuse (may break the output; leave off)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "minimal_fields"
                    label   "Minimal Fields (derive in readPVD)"
                    type    toggle
                    default { "1" }
                    help    "Export only what the Read PVD node needs to derive everything else (displacement, deformation gradient F, Cauchy stress) plus the surface/force arrays you enable. Von Mises, PK1/PK2 and the *_avg variants are skipped, making files much smaller and faster to write; Read PVD computes them on load. Turn off to write every field like upstream PolyFEM."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "scalar_values"
                    label   "Scalar Values"
                    type    toggle
                    default { "1" }
                    disablewhen "{ minimal_fields == 1 }"
                    help    "Export scalar result fields such as von Mises stress (ignored under Minimal Fields, which derives them later)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "tensor_values"
                    label   "Tensor Values"
                    type    toggle
                    default { "1" }
                    disablewhen "{ minimal_fields == 1 }"
                    help    "Export tensor result fields such as the deformation gradient and Cauchy stress (always exported under Minimal Fields)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "high_order_mesh"
                    label   "High Order Mesh"
                    type    toggle
                    default { "1" }
                    help    "Write higher-order elements as curved cells so ParaView/Read PVD can show their curvature. Only for isoparametric or linear meshes with higher-order solutions."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "paraview_wireframe"
                    label   "Wireframe"
                    type    toggle
                    default { "0" }
                    help    "Also write a wireframe (edge) block of the mesh."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "paraview_points"
                    label   "Points"
                    type    toggle
                    default { "0" }
                    help    "Also write the FEM nodes as a separate points block (turned on automatically by Jacobian Validity)."
                    parmtag { "script_callback_language" "python" }
                }
                group {
                    name    "folder2"
                    label   "Volume Specific Data"

                    parm {
                        name    "validity_fields"
                        label   "Jacobian Validity"
                        type    toggle
                        default { "0" }
                        help    "Run a robust check of every deformed element's Jacobian and mark inverted (flipped) elements in the output. Costs extra time per saved step."
                        parmtag { "export_disable" "1" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "velocity_fields"
                        label   "Velocity"
                        type    toggle
                        default { "0" }
                        help    "Export the nodal velocity (dynamic runs)."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "nodes_field"
                        label   "Nodes"
                        type    toggle
                        default { "1" }
                        help    "Export the FEM node positions as a field."
                        parmtag { "export_disable" "1" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "acceleration_fields"
                        label   "Acceleration"
                        type    toggle
                        default { "0" }
                        help    "Export the nodal acceleration (dynamic runs)."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "forces_fields"
                        label   "Forces"
                        type    toggle
                        default { "0" }
                        help    "Export the nodal force vectors of the elastic, inertia and external terms."
                        parmtag { "export_disable" "1" }
                        parmtag { "script_callback_language" "python" }
                    }
                }

                group {
                    name    "folder2_1"
                    label   "Surface Specific Data"

                    parm {
                        name    "normals_fields"
                        label   "Normals"
                        type    toggle
                        default { "0" }
                        help    "Export the surface normals of the boundary mesh (both reference and displaced normals)."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "displaced_normals_fields"
                        label   "Displaced Normals"
                        type    toggle
                        default { "0" }
                        help    "Export the normals of the deformed boundary surface (already included when Normals is on)."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "sidesets_fields"
                        label   "Sidesets"
                        type    toggle
                        default { "0" }
                        help    "Export the sideset (boundary id) of every surface face, so Read PVD can show which faces carry boundary conditions."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "solution_grad_fields"
                        label   "Solution Gradient"
                        type    toggle
                        default { "0" }
                        help    "Export the gradient of the displacement on the surface block."
                        parmtag { "export_disable" "1" }
                        parmtag { "script_callback_language" "python" }
                    }
                }

                group {
                    name    "folder2_2"
                    label   "Contact Surface Data"

                    parm {
                        name    "contact_forces_fields"
                        label   "Contact Forces"
                        type    toggle
                        default { "0" }
                        help    "Export the contact (barrier) force on every surface node into the Contact block -- the field to inspect when validating contact behavior."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "adaptive_dhat"
                        label   "Adaptive dhat"
                        type    toggle
                        default { "0" }
                        help    "Export the local barrier activation distance used with adaptive dhat."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "friction_forces_fields"
                        label   "Friction Forces"
                        type    toggle
                        default { "0" }
                        help    "Export the friction force on every surface node into the Contact block."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "normal_adhesion_forces_fields"
                        label   "Normal Adhesion Forces"
                        type    toggle
                        default { "0" }
                        help    "Export the normal adhesion force on every surface node."
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "tangential_adhesion_forces_fields"
                        label   "Tangential Adhesion Forces"
                        type    toggle
                        default { "0" }
                        help    "Export the tangential adhesion force on every surface node."
                        parmtag { "export_disable" "1" }
                        parmtag { "script_callback_language" "python" }
                    }
                }

                group {
                    name    "folder2_3"
                    label   "Save txt file"

                    parm {
                        name    "solution_file"
                        label   "Solution"
                        type    toggle
                        default { "0" }
                        help    "Also write the raw displacement vector to output/solution.txt (one number per line)."
                        parmtag { "filechooser_mode" "write" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "stress_mat_file"
                        label   "Stress"
                        type    toggle
                        default { "0" }
                        help    "Also write the stress tensors to output/stress_mat.txt."
                        parmtag { "filechooser_mode" "write" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "state_file"
                        label   "State"
                        type    toggle
                        default { "0" }
                        help    "Write the complete solver state to output/state (PolyFEM's state format, used to restart a run)."
                        parmtag { "filechooser_mode" "write" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "rest_mesh_file"
                        label   "Rest Mesh (.msh file)"
                        type    toggle
                        default { "0" }
                        help    "Write the rest (undeformed, possibly remeshed) mesh to output/rest_mesh.msh; needed to restart remeshing runs."
                        parmtag { "filechooser_mode" "write" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "mises_file"
                        label   "von Mises"
                        type    toggle
                        default { "0" }
                        help    "Also write per-node von Mises stress to output/mises.txt."
                        parmtag { "filechooser_mode" "write" }
                        parmtag { "script_callback_language" "python" }
                    }
                    parm {
                        name    "nodes"
                        label   "nodes"
                        type    toggle
                        default { "0" }
                        help    "Also write the FEM node coordinates to output/nodes.txt."
                        parmtag { "filechooser_mode" "write" }
                        parmtag { "script_callback_language" "python" }
                    }
                }

            }

        }

        group {
            name    "folder1_3"
            label   "Advanced"

            parm {
                name    "timestep_prefix"
                label   "Timestep Prefix"
                type    string
                default { "step_" }
                help    "Prefix of the per-step result files (step_0.vtu, step_1.vtu, ...). Change only if another tool expects different names."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sol_on_grid"
                label   "sol_on_grid"
                type    float
                default { "-1" }
                range   { 0 10 }
                help    "Also sample the solution on a regular grid with this spacing (length units) and write it out. -1 = off."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "compute_error"
                label   "compute_error"
                type    toggle
                default { "1" }
                help    "Compute and log error norms of the solution (against an exact solution when the problem has one, otherwise reference norms). Cheap; leave on."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "sol_at_node"
                label   "sol_at_node"
                type    integer
                default { "-1" }
                range   { 0 10 }
                help    "Write the solution value at this node index into the output JSON. -1 = off."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "vis_boundary_only"
                label   "vis_boundary_only"
                type    toggle
                default { "0" }
                help    "Write only the elements touching the boundary to the visualization output (smaller files; interior elements are omitted)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "curved_mesh_size"
                label   "curved_mesh_size"
                type    toggle
                default { "0" }
                help    "When computing the mesh size for curved (higher-order) meshes, upsample the curved edges for a more accurate measure."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "save_solve_sequence_debug"
                label   "save_solve_sequence_debug"
                type    toggle
                default { "0" }
                help    "Save the intermediate states of the boundary-condition (augmented Lagrangian) phase for debugging. Produces many files."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "save_ccd_debug_meshes"
                label   "save_ccd_debug_meshes"
                type    toggle
                default { "0" }
                help    "Save the meshes handed to continuous collision detection whenever it limits a step, for debugging contact problems. Produces many files."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "save_time_sequence"
                label   "save_time_sequence"
                type    toggle
                default { "1" }
                help    "Write a result file for every saved time step (on) or only the final state (off)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "save_nl_solve_sequence"
                label   "save_nl_solve_sequence"
                type    toggle
                default { "0" }
                help    "Save the state after every Newton iteration for debugging. Produces many files and slows the run."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "spectrum"
                label   "spectrum"
                type    toggle
                default { "0" }
                help    "Compute and record the eigenvalue spectrum of the system matrix in the output JSON (only in builds with Spectra; expensive)."
                parmtag { "script_callback_language" "python" }
            }
        }


        group {
            name    "folder1_5"
            label   "Import from Input Files"

            parm {
                name    "old_input_dir"
                label   "Input Directory"
                type    directory
                default { "" }
                help    "Folder of a previous simulation (its root or its input/ folder) whose params.json you want to load into this node. Older PolyFEM files are converted as far as possible."
                parmtag { "filechooser_mode" "read" }
                parmtag { "filechooser_pattern" "" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "newparameter2"
                label   "Import"
                type    button
                default { "0" }
                help    "Read the params.json found in Input Directory and set this node's parameters from it. Geometry, transforms, materials, time, contact and solver settings are restored; anything that could not be mapped is listed in the Import Report."
                parmtag { "export_disable" "1" }
                parmtag { "script_callback" "hou.pwd().hm().read_params(kwargs)" }
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "labelparm4"
                label   "Message"
                type    label
                default { "*Select either a previous simulation root or its input folder.\n*Compatible older PolyFEM JSON files are imported as far as possible.\n*See Import Report for values that could not be reconstructed." }
                parmtag { "sidefx::look" "block" }
            }
            parm {
                name    "import_report"
                label   "Import Report"
                type    string
                default { "No parameter folder has been imported." }
                disablewhen "{ old_input_dir != __polyfem_report_edit_sentinel__ }"
                help    "Notes from the last import: values that were converted, dropped or could not be reconstructed. Read-only."
                parmtag { "editor" "1" }
                parmtag { "sidefx::look" "block" }
            }
        }

    }

}
