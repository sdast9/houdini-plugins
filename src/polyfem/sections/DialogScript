                disablewhen "{ solver != Pardiso }"
                hidewhen "{ solver != Pardiso }"
                menu {
                    "1"     "1"
                    "2"     "2"
                    "-2"    "-2"
                    "3"     "3"
                    "4"     "4"
                    "-4"    "-4"
                    "6"     "6"
                    "11"    "11"
                    "13"    "13"
                }
                help    "Pardiso matrix type code: 2 = symmetric positive definite, -2 = symmetric indefinite (safe for regularized Newton), 11 = general nonsymmetric. Only for the Pardiso solver (MKL builds)."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "max_iter_hypre"
                label   "Max Iterations"
                type    intlog
                default { "1000" }
                disablewhen "{ solver != Hypre }"
                hidewhen "{ solver != Hypre }"
                range   { 0 100000 }
                help    "Maximum iterations of the Hypre algebraic-multigrid solver per Newton step."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "pre_max_iter_hypre"
                label   "Pre Max Iterations"
                type    integer
                default { "1" }
                disablewhen "{ solver != Hypre }"
                hidewhen "{ solver != Hypre }"
                range   { 0 10 }
                help    "Accepted for compatibility with PolySolve's Hypre settings but not used by the current Hypre wrapper, which always applies one multigrid V-cycle per iteration. Leave at 1."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "theta_hypre"
                label   "Strength Threshold"
                type    float
                default { "0.5" }
                disablewhen "{ solver != Hypre }"
                hidewhen "{ solver != Hypre }"
                range   { 0 1 }
                help    "Hypre's strength-of-connection threshold (theta) used to build the coarse levels: couplings weaker than this fraction of the strongest coupling in a row are ignored when grouping unknowns. 0.25 suits 2-D problems, 0.5 (default) suits 3-D elasticity; higher values give a cheaper but weaker preconditioner. Only for the Hypre solver."
                parmtag { "script_callback_language" "python" }
