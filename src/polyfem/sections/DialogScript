                    name    "ncycle"
                    label   "Num Cycles"
                    type    integer
                    default { "2" }
                    disablewhen "{ solver != AMGCL }"
                    hidewhen "{ solver != AMGCL }"
                    range   { 0 10 }
                    help    "Number of multigrid cycles AMGCL performs per preconditioner application (1 = V-cycle, 2 = W-cycle)."
                    parmtag { "script_callback_language" "python" }
                }
                parm {
                    name    "sepparm3"
                    label   "Spacer"
                    type    separator
                    default { "" }
                    parmtag { "sidefx::layout_height" "small" }
                    parmtag { "sidefx::look" "blank" }
                }
                group {
                    name    "Coarsening_Parameters"
                    label   "Coarsening Parameters"
                    disablewhen "{ solver != AMGCL }"
                    hidewhen "{ solver != AMGCL }"

                    parm {
                        name    "coarsening_type"
                        label   "Coarse Type"
                        type    ordinal
                        default { "0" }
                        disablewhen "{ solver != AMGCL }"
                        hidewhen "{ solver != AMGCL }"
                        menu {
                            "smoothed_aggregation"  "smoothed_aggregation"
                            "aggregation"           "aggregation"
                            "ruge_stuben"           "ruge_stuben"
                            "smoothed_aggr_emin"    "smoothed_aggr_emin"
