            disablewhentab "{ enable == 0 }"
            hidewhentab "{ enable == 0 }"

            parm {
                name    "broad_phase"
                label   "Broad Phase"
                type    ordinal
                default { "3" }
                disablewhen "{ enable == 0 }"
                menu {
                    "hash_grid"                     "Hash Grid"
                    "brute_force"                   "Brute Force"
                    "spatial_hash"                  "Spatial Hash"
                    "BVH"                           "BVH"
                    "sweep_and_prune"               "Sweep and Prune"
                    "sweep_and_tiniest_queue_gpu"   "Sweep and Tiniest Queue (GPU)"
