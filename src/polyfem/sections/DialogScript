                hidewhen "{ solver != Hypre }"
                help    "Coarsen the three displacement components of each node together instead of treating every unknown separately. This is the recommended setting for elasticity and was faster and more reliable in tests; the HDA also tells Hypre the problem is 3-D (dimension = 3) so these elasticity options take effect. Turn it off only to reproduce PolySolve's plain scalar default."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "tolerance_hypre_AMGCL"
                label   "Tolerance"
                type    log
                default { "1e-10" }
                disablewhen "{ solver != Hypre solver != AMGCL }"
                hidewhen "{ solver != Hypre solver != AMGCL }"
                range   { 1e-20 1 }
                help    "Relative residual at which the Hypre or AMGCL iterative solver stops."
                parmtag { "script_callback_language" "python" }
            }
