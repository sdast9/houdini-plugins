                help    "GCP: smoothness of the tangent-angle test that decides which surface pairs interact. Between -1 and 1; 0.5 is the reference value."
                parmtag { "script_callback_language" "python" }
            }
            parm {
                name    "alpha_n"
                label   "Normal Angle Control"
                type    float
                default { "0.5" }
                disablewhen "{ enable == 0 } { gcp_enable == 0 }"
                range   { -1! 1! }
                help    "GCP: smoothness of the normal-angle test that decides which surface pairs interact. Between -1 and 1; 0.5 is the reference value."
                parmtag { "script_callback_language" "python" }
            }
        }

        group {
            name    "barrier_tab_2"
            label   "Friction"
            disablewhentab "{ enable == 0 }"

            parm {
                name    "cof"
                label   "COF"
